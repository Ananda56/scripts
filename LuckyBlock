-- States & Logic Variables
local States = {
    BoostFPS = false,
    SpawnGalaxyBlock = false, -- สถานะเปิดปิดลูป Spawn Galaxy Block
    SpawnAllPlayers = false,  -- สถานะสปอนให้ผู้เล่นคนอื่นด้วย
    WalkSpeed = 16,
    JumpHeight = 50,
    FakeFPSValue = 60
