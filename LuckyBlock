-- ฟังก์ชันค้นหา Remote Event แบบทั่วทั้งเกม (ป้องกันหาไม่เจอเพราะซ่อนอยู่ใน Folder)
local function GetSpawnEvent()
    -- หาใน ReplicatedStorage ก่อน
    local found = ReplicatedStorage:FindFirstChild("SpawnGalaxyBlock", true)
    if found then return found end
    
    -- หาในตัว Player หรือ Character
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("SpawnGalaxyBlock", true) then
        return char:FindFirstChild("SpawnGalaxyBlock", true)
    end
    if LocalPlayer:FindFirstChild("SpawnGalaxyBlock", true) then
        return LocalPlayer:FindFirstChild("SpawnGalaxyBlock", true)
    end
    
    return nil
end

-- ระบบลูป Turbo Fire สำหรับ Spawn Galaxy Block (ส่งรัวๆ และปลอดภัยด้วย pcall)
task.spawn(function()
    while true do
        if States.SpawnGalaxyBlock then
            pcall(function()
                local spawnEvent = GetSpawnEvent()
                
                if spawnEvent and spawnEvent:IsA("RemoteEvent") then
                    local character = LocalPlayer.Character
                    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
                    
                    -- กรณีที่รีโมทต้องการพิกัดตำแหน่ง (CFrame หรือ Vector3 หน้าตัวผู้เล่น)
                    local spawnPosition = rootPart and (rootPart.CFrame + rootPart.CFrame.LookVector * 5)
                    
                    -- 1. สปอนให้ตัวเราเอง (ลองส่งทั้งแบบว่างเปล่า และแบบแนบพิกัด/ตัวละคร เพื่อให้รองรับทุกรูปแบบโค้ดเกม)
                    pcall(function() spawnEvent:FireServer() end)
                    if spawnPosition then
                        pcall(function() spawnEvent:FireServer(spawnPosition) end)
                        pcall(function() spawnEvent:FireServer(rootPart.Position) end)
                    end
                    
                    -- 2. สปอนให้ผู้เล่นคนอื่นในเซิร์ฟเวอร์
                    if States.SpawnAllPlayers then
                        for _, player in ipairs(Players:GetPlayers()) do
                            if player ~= LocalPlayer then
                                pcall(function()
                                    spawnEvent:FireServer(player)
                                    local pChar = player.Character
                                    local pRoot = pChar and pChar:FindFirstChild("HumanoidRootPart")
                                    if pRoot then
                                        spawnEvent:FireServer(pRoot.Position)
                                    end
                                end)
                            end
                        end
                    end
                end
            end)
        end
        -- ความเร็วลูปแบบเสถียร (ปรับให้ไวขึ้นเพื่อให้บล็อกรัวออกจริง)
        task.wait(0.05)
    end
end)

