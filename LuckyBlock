-- ระบบลูป Spawn Galaxy Block (ทำงานตามสถานะ Toggle)
task.spawn(function()
    while true do
        if States.SpawnGalaxyBlock then
            pcall(function()
                local spawnEvent = ReplicatedStorage:WaitForChild("SpawnGalaxyBlock", 2)
                
                if spawnEvent then
                    -- 1. สปอนให้ตัวเราเอง
                    spawnEvent:FireServer()
                    
                    -- 2. ถ้าติ๊กเลือกสปอนให้ผู้เล่นคนอื่นด้วย จะทำการลูปส่งให้ทุกคนในเซิร์ฟเวอร์
                    if States.SpawnAllPlayers then
                        for _, player in ipairs(Players:GetPlayers()) do
                            if player ~= LocalPlayer then
                                -- ขึ้นอยู่กับ Remote ของเกมว่ารองรับการส่ง Arguments ระบุตัวตนหรือไม่
                                -- หาก Remote รองรับการส่ง Player หรือ Character เป็นพารามิเตอร์ สามารถใส่เพิ่มได้ที่นี่
                                pcall(function()
                                    spawnEvent:FireServer(player)
                                end)
                            end
                        end
                    end
                end
            end)
        end
        -- ความเร็วในการลูป (ปรับค่าได้ตามความเหมาะสมเพื่อไม่ให้เซิร์ฟเวอร์แลคหรือโดนเตะ)
        task.wait(0.1)
    end
end)

